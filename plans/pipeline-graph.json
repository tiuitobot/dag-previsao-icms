{
  "version": "1.0",
  "pipeline": "dag-previsao-icms",
  "description": "Pipeline DAG para previsão de ICMS-SP com steps determinísticos e etapas opcionais via Copilot CLI.",
  "steps": [
    {"id": "01-download-dados", "name": "Download de dados externos e ingestão do histórico", "executor": "deterministic", "script": "scripts/steps/step_01_download_dados.py", "contract": "contracts/01-download-dados.md", "inputs": [], "outputs": ["workspace/outputs/active/dados_brutos.json"], "dependencies": []},
    {"id": "02-preparacao-base", "name": "Preparação da base e projeção das exógenas", "executor": "deterministic", "script": "scripts/steps/step_02_preparacao_base.py", "contract": "contracts/02-preparacao-base.md", "inputs": ["workspace/outputs/active/dados_brutos.json"], "outputs": ["workspace/outputs/active/base_preparada.json"], "dependencies": ["01-download-dados"]},
    {"id": "03-modelagem", "name": "Ajuste e validação dos 5 modelos SARIMAX", "executor": "deterministic", "script": "scripts/steps/step_03_modelagem.py", "contract": "contracts/03-modelagem.md", "inputs": ["workspace/outputs/active/base_preparada.json"], "outputs": ["workspace/outputs/active/modelagem.json"], "dependencies": ["02-preparacao-base"]},
    {"id": "04-previsoes", "name": "Previsões, ensemble e Monte Carlo", "executor": "deterministic", "script": "scripts/steps/step_04_previsoes.py", "contract": "contracts/04-previsoes.md", "inputs": ["workspace/outputs/active/base_preparada.json", "workspace/outputs/active/modelagem.json"], "outputs": ["workspace/outputs/active/previsoes.json"], "dependencies": ["03-modelagem"]},
    {"id": "05-analise-qualitativa", "name": "Leitura qualitativa do cenário", "executor": "copilot_cli", "contract": "contracts/05-analise-qualitativa.md", "model": "gpt-4", "inputs": ["workspace/outputs/active/previsoes.json"], "outputs": ["workspace/outputs/active/analise_qualitativa.json"], "dependencies": ["04-previsoes"], "optional": true},
    {"id": "06-cenarios", "name": "Construção de cenários alternativos", "executor": "copilot_cli", "contract": "contracts/06-cenarios.md", "model": "gpt-4", "inputs": ["workspace/outputs/active/previsoes.json", "workspace/outputs/active/analise_qualitativa.json"], "outputs": ["workspace/outputs/active/cenarios.json"], "dependencies": ["05-analise-qualitativa"], "optional": true},
    {"id": "07-visualizacao", "name": "Geração de gráficos e artefatos visuais", "executor": "deterministic", "script": "scripts/steps/step_07_visualizacao.py", "contract": "contracts/07-visualizacao.md", "inputs": ["workspace/outputs/active/base_preparada.json", "workspace/outputs/active/previsoes.json"], "outputs": ["workspace/outputs/active/visualizacoes.json"], "dependencies": ["04-previsoes"]},
    {"id": "08-relatorio-narrativa", "name": "Narrativa executiva do relatório", "executor": "copilot_cli", "contract": "contracts/08-relatorio-narrativa.md", "model": "gpt-4", "inputs": ["workspace/outputs/active/previsoes.json", "workspace/outputs/active/visualizacoes.json", "workspace/outputs/active/cenarios.json"], "outputs": ["workspace/outputs/active/relatorio_narrativa.json"], "dependencies": ["06-cenarios", "07-visualizacao"], "optional": true},
    {"id": "09-pdf-output", "name": "Renderização HTML e PDF", "executor": "deterministic", "script": "scripts/steps/step_09_pdf_output.py", "contract": "contracts/09-pdf-output.md", "inputs": ["workspace/outputs/active/previsoes.json", "workspace/outputs/active/visualizacoes.json", "workspace/outputs/active/relatorio_narrativa.json"], "outputs": ["workspace/outputs/active/relatorio_final.json"], "dependencies": ["07-visualizacao", "08-relatorio-narrativa"]}
  ]
}
